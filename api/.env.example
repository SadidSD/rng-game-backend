# Environment Variables Template
# Copy this to .env and fill in your values

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# JWT Authentication
JWT_SECRET="YOUR_64_CHAR_HEX_SECRET_HERE"

# Store Configuration
SINGLE_TENANT_STORE_ID="YOUR_STORE_UUID_HERE"

# API Security
FRONTEND_API_KEY="YOUR_32_CHAR_HEX_SECRET_HERE"

# Stripe Payment (Get from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY="sk_test_... or sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Frontend URL (for Stripe redirects)
FRONTEND_URL="http://localhost:3000"  # or your production domain

# Sentry Error Monitoring (Get from https://sentry.io)
SENTRY_DSN="https://...@sentry.io/..."

# Manapool (Optional - for price data)
MANAPOOL_ACCESS_TOKEN="mpat_..."
