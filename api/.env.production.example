# ============================================================
# PRODUCTION ENVIRONMENT TEMPLATE
# Copy this file to .env.production and fill in real values.
# NEVER commit .env.production to git.
# ============================================================

# Core
NODE_ENV=production
PORT=10000

# Database (Supabase)
# Get from: Supabase Dashboard → Project Settings → Database → Connection string (Transaction mode for DATABASE_URL, Direct mode for DIRECT_URL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=20&pool_timeout=60"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Auth
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET

# API Key (used by frontend to access public endpoints)
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
FRONTEND_API_KEY=REPLACE_WITH_32_CHAR_HEX

# Single-Tenant Store ID
# Get from your database: SELECT id FROM "Store" LIMIT 1;
SINGLE_TENANT_STORE_ID=REPLACE_WITH_STORE_UUID

# Admin Credentials (used only for initial setup scripts, NOT stored in backend at runtime)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Stripe
# Get from: https://dashboard.stripe.com/apikeys (use sk_live_... for production)
STRIPE_SECRET_KEY=sk_live_REPLACE_WITH_YOUR_STRIPE_KEY
# Get from: Stripe Dashboard → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_AFTER_WEBHOOK_SETUP

# Frontend URL (used for Stripe success/cancel redirects)
FRONTEND_URL=https://your-frontend-domain.com

# Admin Dashboard URL (used for CORS whitelist)
ADMIN_DASHBOARD_URL=https://your-admin-dashboard.vercel.app

# Sentry (optional — for error tracking)
# Get from: https://sentry.io → Your Project → Settings → Client Keys (DSN)
SENTRY_DSN=https://YOUR_KEY@sentry.io/PROJECT_ID

# Manapool (for buylist remote search)
MANAPOOL_ACCESS_TOKEN=mpat_REPLACE_WITH_YOUR_TOKEN

# Email Notifications via Resend (optional but recommended)
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_REPLACE_WITH_YOUR_RESEND_KEY
RESEND_FROM_EMAIL=store@yourdomain.com
